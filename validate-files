"""Validate the files generated by mpi-photometry

$HOME/code/desihub/desi-photometry/validate-files --specprod fuji --statistics --validate --mp 128 $PSCRATCH/lsdr9/fuji
$HOME/code/desihub/desi-photometry/validate-files --specprod iron --statistics --validate --mp 128 $PSCRATCH/lsdr9/iron
$HOME/code/desihub/desi-photometry/validate-files --specprod guadalupe --statistics --validate --mp 128 $PSCRATCH/lsdr9/guadalupe

"""
import os
import sys
import re
import argparse
from glob import glob
import multiprocessing
import numpy as np
from astropy.io import fits
from astropy.table import Table, hstack


def _targets_one_tile(args):
    """Multiprocessing wrapper.
    """
    return targets_one_tile(*args)


def targets_one_tile(tileid, obstile, pottile):
    """Check one file.
    """
    print(f'  Checking tile {tileid}')
    # Check that the set of targetids are unique.
    try:
        assert len(obstile) == len(np.unique(obstile['TARGETID']))
        assert len(pottile) == len(np.unique(pottile['TARGETID']))

    # Check that every target in the targetphot file is also in the
    # targetphot-potential file.
        K = np.isin(obstile['TARGETID'], pottile['TARGETID'], assume_unique=True)
        assert len(K) == len(obstile['TARGETID'])
    except AssertionError:
        print(f'  Problem with tile {tileid}!')

    # Now, ensure that the data stored in the potential and observed catalogs
    # *for the same objects* are identical.
    # I = np.isin(pottile['TARGETID'], obstile['TARGETID'], assume_unique=True)
    I = np.hstack([np.where(tid == pottile['TARGETID'])[0] for tid in obstile['TARGETID']])
    pot = pottile[I]
    assert np.all(pot['TARGETID'] == obstile['TARGETID'])
    for col in pot.colnames:
        diff = np.where(pot[col] != obstile[col])[0]
        if len(diff) > 0:
            J = ~np.isnan(obstile[col][diff]) # need to check nan separately
            if np.sum(J) > 0:
                diff = diff[J]
                print(col, pot[col][diff].data, obstile[col][diff].data)


def find_files(output_dir):
    """Find target and photometry files in `output_dir`.
    """
    target, tractor = dict(), dict()
    for k in ('observed', 'potential'):
        target[k] = glob(os.path.join(output_dir, f'{k}-targets', '*.fits'))
        tractor[k] = glob(os.path.join(output_dir, f'{k}-targets', 'tractorphot', '*.fits'))
    return (target, tractor)


def verify_filenames(specprod, target, tractor):
    """Verify the names of the files found by find_files.
    """
    target_re = re.compile(f'targetphot(-potential|)(-[a-z123]+)?(-[a-z-]+)?-{specprod}\\.fits')
    target_hp_re = re.compile(f'targetphot(-potential|)-nside([0-9]+)-hp([0-9]+)-([a-z123]+)([a-z-]+)?-{specprod}\\.fits')
    tractor_re = re.compile(f'tractorphot(-potential|)-nside([0-9]+)-hp([0-9]+)-{specprod}\\.fits')
    for k in ('observed', 'potential'):
        assert all([target_re.match(os.path.basename(filename)) is not None or target_hp_re.match(os.path.basename(filename)) is not None for filename in target[k]])
        assert all([tractor_re.match(os.path.basename(filename)) is not None for filename in tractor[k]])
    return (target_re, target_hp_re, tractor_re)


def gather_file_info(filenames, res, hdu='TARGETPHOT'):
    """Gather file size and number of rows.
    """
    file_info = {'observed': dict(), 'potential': dict()}
    for k in ('observed', 'potential'):
        for filename in filenames[k]:
            b = os.path.basename(filename)
            m = res[0].match(b)
            if hdu == 'TARGETPHOT':
                m = res[0].match(b)
                m_hp = res[1].match(b)
            else:
                m = None
                m_hp = res[0].match(b)
            groups = m_hp.groups() if m is None else m.groups()
            with fits.open(filename, readonly=True) as hdulist:
                rows = hdulist[hdu].header['NAXIS2']
            file_info[k][b] = {'fullname': filename,
                               'hp': (m_hp is not None),
                               'size': os.path.getsize(filename),
                               'groups': groups,
                               'rows': rows}
    return file_info


def fmt_bytes(b):
    """Convert integer bytes `b` to a formatted string.
    """
    prefix = ('', 'k', 'M', 'G', 'T', 'P', 'E', 'Z', 'Y', 'R', 'Q')
    bb = float(b)
    p = 0
    while bb > 1024.0:
        bb /= 1024.0
        p += 1
    return f"{bb:.3g} {prefix[p]}B"


def target_statistics(specprod, info):
    """Gather and format statistics on target files.
    """
    table = dict()
    for k in ('observed', 'potential'):
        table[k] = ['| File Name | File Size | Number of Targets | Notes |',
                    '|-----------|:---------:|:-----------------:|-------|']
        hp_totals = dict()
        for f in sorted(info[k].keys()):
            if info[k][f]['groups'][-2] is None:
                survey, program = '', ''
            else:
                if info[k][f]['groups'][-1] is None:
                    survey = info[k][f]['groups'][-2].replace('-', '')
                    program = ''
                else:
                    survey, program = info[k][f]['groups'][-2].replace('-', ''), info[k][f]['groups'][-1].replace('-', '')
            if info[k][f]['hp']:
                if (survey, program) in hp_totals:
                    hp_totals[(survey, program)]['size'] += info[k][f]['size']
                    hp_totals[(survey, program)]['rows'] += info[k][f]['rows']
                else:
                    g = info[k][f]['groups']
                    if program:
                        name = f"targetphot{g[0]}-nside{g[1]}-hp[0-9]{{{len(g[2])}}}-{survey}-{program}-{specprod}\\.fits"
                    else:
                        name = f"targetphot{g[0]}-nside{g[1]}-hp[0-9]{{{len(g[2])}}}-{survey}-{specprod}\\.fits"
                    hp_totals[(survey, program)] = {'size': info[k][f]['size'],
                                                    'rows': info[k][f]['rows'],
                                                    'name': name}
            else:
                if survey:
                    if program:
                        table[k].append(f"| {f} | {fmt_bytes(info[k][f]['size'])} | {info[k][f]['rows']:,d} | {survey}, {program} |")
                    else:
                        table[k].append(f"| {f} | {fmt_bytes(info[k][f]['size'])} | {info[k][f]['rows']:,d} | {survey} |")
                else:
                    table[k].append(f"| {f} | {fmt_bytes(info[k][f]['size'])} | {info[k][f]['rows']:,d} | Concatenation of all files. |")
        for survey, program in hp_totals:
            if program:
                table[k].append(f"| {hp_totals[(survey, program)]['name']} | {fmt_bytes(hp_totals[(survey, program)]['size'])} | {hp_totals[(survey, program)]['rows']:,d} | {survey}, {program} |")
            else:
                table[k].append(f"| {hp_totals[(survey, program)]['name']} | {fmt_bytes(hp_totals[(survey, program)]['size'])} | {hp_totals[(survey, program)]['rows']:,d} | {survey} |")
        table[k].append('')
    return table


def tractor_statistics(specprod, info):
    """Gather and format statistics on tractor files.
    """
    table = dict()
    for k in ('observed', 'potential'):
        table[k] = ['| File Name | File Size | Number of Targets | Notes |',
                    '|-----------|:---------:|:-----------------:|-------|']
        ex = info[k][list(info[k].keys())[0]]
        generic_name = f"tractorphot{ex['groups'][0]}-nside{ex['groups'][1]}-hp[0-9]{{{len(ex['groups'][2])}}}-{specprod}\\.fits"
        total_size = sum([info[k][f]['size'] for f in info[k]])
        total_rows = sum([info[k][f]['rows'] for f in info[k]])
        table[k].append(f"| {generic_name} | {fmt_bytes(total_size)} | {total_rows:,d} | |")
        table[k].append('')
    return table


def validation_pairs(target):
    """Pair observed target files with corresponding potential target files.
    """
    pairs = dict()
    for t in target['observed']:
        foo = os.path.basename(t).split('-')
        if 'nside' in foo[1]:
            if len(foo) == 5:
                survey = foo[3]
                program = ''
            else:
                survey = foo[3]
                program = foo[4]
            if (survey, program) in pairs:
                pairs[(survey, program)][0].append(t)
            else:
                foo[1] = 'nside?'
                foo[2] = 'hp*'
                foo.insert(1, 'potential')
                bar = glob.glob(os.path.join(os.path.dirname(os.path.dirname(t)), 'potential-targets', '-'.join(foo)))
                for b in bar:
                    assert b in target['potential']
                pairs[(survey, program)] = [[t, ], bar]
        else:
            survey = foo[1]
            if len(foo) == 4:
                program = foo[2]
            else:
                program = ''
            foo.insert(1, 'potential')
            bar = os.path.join(os.path.dirname(os.path.dirname(t)), 'potential-targets', '-'.join(foo))
            assert bar in target['potential']
            pairs[(survey, program)] = [t, bar]
    return pairs


def main():
    """Entry-point for command-line scripts.

    Returns
    -------
    :class:`int`
        An integer suitable for passing to :func:`sys.exit`.
    """
    p = argparse.ArgumentParser(prog=os.path.basename(sys.argv[0]))
    p.add_argument('--specprod', choices=['fuji', 'iron', 'guadalupe', 'loa', 'nevis'],
                   help='Spectroscopic data reduction.')
    p.add_argument('--mp', type=int, default=1, metavar='N', help='Number of multiprocessing cores.')
    p.add_argument('--statistics', action='store_true', help='Do file statistics.')
    p.add_argument('--validate', action='store_true', help='Validate the files.')
    p.add_argument('outdir', metavar='DIR', help='Output directory.')
    args = p.parse_args()
    #
    # Find files.
    #
    target, tractor = find_files(args.outdir)
    #
    # Do statistics.
    #
    if args.statistics:
        target_re, target_hp_re, tractor_re = verify_filenames(args.specprod, target, tractor)
        target_info = gather_file_info(target, (target_re, target_hp_re))
        tractor_info = gather_file_info(tractor, (tractor_re, ), hdu='TRACTORPHOT')
        target_tables = target_statistics(args.specprod, target_info)
        tractor_tables = tractor_statistics(args.specprod, tractor_info)
        statistics_report = [f'# Summary of desi-photometry files for {args.specprod}',
                             '',
                             '## target files, observed',
                             '']
        statistics_report += target_tables['observed']
        statistics_report += ['## target files, potential', '']
        statistics_report += target_tables['potential']
        statistics_report += ['## tractor files, potential', '']
        statistics_report += tractor_tables['observed']
        statistics_report += ['## tractor_files, potential', '']
        statistics_report += tractor_tables['potential']
        print("\n".join(statistics_report))
    #
    # Validate files.
    #
    if args.validate:
        #
        # Pair observed targetphot files with potentials.
        #
        pairs = validation_pairs(target)
        for survey, program in pairs:
            print('Working on survey, program {}, {}.'.format(survey, program))
            obs_files = pairs[(survey, program)][0]
            pot_files = pairs[(survey, program)][1]
            if isinstance(obs_files, str):
                obs_files = [obs_files]
                pot_files = [pot_files]
            obs_tables = list()
            for obs_file in obs_files:
                obs = Table.read(obs_file, hdu='TARGETPHOT')
                print('Read {:,d} objects from {}'.format(len(obs), obs_file))
                obs_tables.append(obs)
            pot_tables = list()
            for pot_file in pot_files:
                pot = Table.read(pot_file, hdu='TARGETPHOT')
                print('Read {:,d} objects from {}'.format(len(pot), pot_file))
                pot_tables.append(pot)
            if len(obs_files) == 1:
                obs = obs_tables[0]
                pot = pot_tables[0]
            else:
                obs = hstack(obs_tables)
                pot = hstack(pot_tables)
            tileids = np.unique(obs['TILEID'])
            print('Processing {} unique tiles'.format(len(tileids)))
            #
            # Multiprocess over tiles
            #
            mpargs = [[tileid, obs[obs['TILEID'] == tileid], pot[pot['TILEID'] == tileid]] for tileid in tileids]
            if args.mp > 1:
                with multiprocessing.get_context('fork').Pool(args.mp) as P:
                    P.map(_targets_one_tile, mpargs)
            else:
                [targets_one_tile(*mparg) for mparg in mpargs]
    return 0


if __name__ == '__main__':
    sys.exit(main())
